        stage ('Docker Build'){
            steps{
                sh '''
                docker build -t oforiwaa/devops-demo:${BUILD_NUMBER} .
                '''
            }
        }

        stage ('Docker Push'){
            steps{
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                    sh '''
                    echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin
                    docker push  "oforiwaa/devops-demo:${BUILD_NUMBER}"
                    docker logout
                    '''
                }
            }
        }

            stage ('Docker Run'){
                steps{
                    sh 'docker run --rm oforiwaa/devops-demo:${BUILD_NUMBER}'
                }
            }

        stage ('Test'){
            steps{
                echo "Running tests"
            }
        }

        stage ("Deploy"){
            steps{
                echo "Deploying application"
            }
        }
    }
}